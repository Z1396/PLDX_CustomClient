{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/build/debug",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "rel-with-debug-info",
            "displayName": "RelWithDebugInfo",
            "binaryDir": "${sourceDir}/build/rel-with-debug-info",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebugInfo"
            }
        },
        {
            "name": "release",
            "displayName": "Release (Windows clang-cl)",
            "binaryDir": "${sourceDir}/build/release",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (需 GCC 12+ / Clang 16+，因使用 std::expected)",
            "binaryDir": "${sourceDir}/build/linux-release",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (需 GCC 12+ / Clang 16+)",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": 6
        },
        {
            "name": "rel-with-debug-info",
            "configurePreset": "rel-with-debug-info"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "jobs": 4
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "jobs": 4
        }
    ]
}